+        assert_eq!(opened.stream_position().unwrap(), FILE_SIZE_CAP + 1);
+        std::fs::write(&source, b"original").unwrap();
+        let opened = std::fs::File::open(&source).unwrap();
+        std::fs::rename(&source, root.path().join("old")).unwrap();
